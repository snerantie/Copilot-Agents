# --- Server ---
PORT=3000

# --- Jira Cloud ---
# Your Atlassian site, e.g. acme.atlassian.net
JIRA_HOST=your-domain.atlassian.net
# Email of the Atlassian user the API token belongs to
JIRA_EMAIL=admin@example.com
# API token generated at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=replace-me
# Project key to log tickets into
JIRA_PROJECT_KEY=MANCO
# Default issue type (Task, Bug, Story, etc.)
JIRA_DEFAULT_ISSUE_TYPE=Task

# --- GitHub Copilot Extension ---
# Optional: validate that requests are signed by GitHub.
# Set to the public key fetched from https://api.github.com/meta/public_keys/copilot_api
# Leave empty in development to skip signature verification.
GITHUB_PUBLIC_KEY_IDENTIFIER=
